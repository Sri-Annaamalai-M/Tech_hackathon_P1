PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentinelflow

# GitHub webhook signature secret from repository webhook settings.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# GitHub fine-grained token with Pull requests: read/write and Contents: read.
GITHUB_TOKEN=github_pat_replace_me

# OpenAI API key for AI-assisted security review.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4.1-mini

# Optional comma-separated origins. Empty allows same-origin dashboard use.
CORS_ORIGIN=
